#!/bin/bash

echo building go
g++ -O3 HOST_stm32_go.cpp -o go
echo building bootloader
g++ -O3 HOST_stm32_bootloader.cpp -o bootloader
echo building USART prober
g++ -O3 USART_prober.cpp -o USART_prober

echo cleaning
rm -f firmware.elf
rm -f firmware.o
rm -f firmware.elf
rm -f firmware.bin

echo compiling
#-fsanitize=undefined
#arm-none-eabi-g++ -O1 -c -fno-common -mcpu=cortex-m4 -mthumb firmware.cpp -o firmware.o
arm-none-eabi-g++ -Os -c -fno-common -mcpu=cortex-m4 firmware.cpp -o firmware.o

echo linking
arm-none-eabi-ld -T linker.ld -o firmware.elf firmware.o
#rm main.o
arm-none-eabi-objcopy -O binary -j .text firmware.elf firmware.bin.text
arm-none-eabi-objcopy -O binary -j .data firmware.elf firmware.bin.data
cat firmware.bin.text > firmware.bin
cat firmware.bin.data >> firmware.bin
rm -f firmware.bin.text firmware.bin.data

echo elf to asm
arm-none-eabi-objdump -D firmware.elf > firmware.dis

echo  bin to asm
arm-none-eabi-objdump -D -bbinary -marm firmware.bin -Mforce-thumb > firmware_direct.dis

echo extracting symbols
arm-none-eabi-nm firmware.elf > firmware.sym
